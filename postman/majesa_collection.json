          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos?solo_activos=true&skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["productos"],
              "query": [
                {
                  "key": "solo_activos",
                  "value": "true"
                },
                {
                  "key": "id_categoria",
                  "value": "1",
                  "disabled": true
